# Copy to ui/.streamlit/secrets.toml for local dev, and paste the same keys into
# the Streamlit Community Cloud "Secrets" box when deploying.
# NEVER commit the real secrets.toml (it must be in .gitignore).

API_URL = ""                 # local: "http://127.0.0.1:8000" | deployed: your Render URL
SUPABASE_URL = ""
# The ANON key is public-safe: RLS allows SELECT on `runs` and `predictions` only.
# Do NOT put the service-role key here.
SUPABASE_ANON_KEY = ""